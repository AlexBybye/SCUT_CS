{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scut-senior.invalid/contracts/v1/evaluation-case.schema.json",
  "title": "SCUT Senior Evaluation Case V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_only",
    "case_id",
    "category",
    "course_id",
    "workflow_type",
    "knowledge_scope",
    "course_scope",
    "allowed_course_ids",
    "turns",
    "expected"
  ],
  "properties": {
    "fixture_only": {"const": true},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "category": {
      "enum": [
        "course_knowledge",
        "past_paper_question",
        "sparse_general_supplement",
        "insufficient_evidence",
        "multi_turn_followup",
        "cross_course_scope",
        "source_marking",
        "exam_review_with_syllabus",
        "exam_review_without_syllabus"
      ]
    },
    "syllabus": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "weak_topics": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "course_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "workflow_type": {
      "enum": [
        "knowledge_qa",
        "exam_review",
        "problem_tutor",
        "mistake_review",
        "temporary_material_reading"
      ]
    },
    "knowledge_scope": {"enum": ["course_only", "course_first"]},
    "course_scope": {"enum": ["single", "cross"]},
    "allowed_course_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_status",
        "evidence_status",
        "required_answer_block_types",
        "requires_citation",
        "allows_general"
      ],
      "properties": {
        "answer_status": {
          "enum": [
            "answered",
            "partial",
            "insufficient_evidence",
            "needs_clarification",
            "refused",
            "error"
          ]
        },
        "evidence_status": {
          "enum": ["sufficient", "partial", "insufficient", "not_evaluated"]
        },
        "required_answer_block_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["repository", "user_material", "general", "personalized_analysis"]
          }
        },
        "requires_citation": {"type": "boolean"},
        "allows_general": {"type": "boolean"},
        "required_locator_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["page", "slide", "question", "heading"]}
        },
        "requires_exam_review_plan": {"type": "boolean"},
        "review_path": {"enum": ["with_syllabus", "without_syllabus"]},
        "notes": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"course_scope": {"const": "single"}}},
      "then": {
        "properties": {
          "course_id": {"type": "string", "minLength": 1},
          "allowed_course_ids": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"course_scope": {"const": "cross"}}},
      "then": {
        "properties": {
          "course_id": {"type": "null"},
          "allowed_course_ids": {"minItems": 2}
        }
      }
    }
  ]
}
