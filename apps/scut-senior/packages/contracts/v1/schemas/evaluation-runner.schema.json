{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scut-senior.invalid/contracts/v1/evaluation-runner.schema.json",
  "title": "SCUT Senior Evaluation Runner V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_only",
    "contract_version",
    "runner_id",
    "execution_mode",
    "case_file",
    "case_ids",
    "group_by",
    "fail_on_missing_case"
  ],
  "properties": {
    "fixture_only": {"const": true},
    "contract_version": {"const": "v1"},
    "runner_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "execution_mode": {"const": "mock"},
    "case_file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+[.]json$"},
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "group_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["course_id", "category"]}
    },
    "fail_on_missing_case": {"type": "boolean"}
  }
}
