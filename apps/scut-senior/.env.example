# Default local profile is deliberately Mock-only. Production refuses this profile.
SCUT_SENIOR_APP_ENV=development
SCUT_SENIOR_IDENTITY_MODE=mock
# Real GitHub OAuth is opt-in and requires an HTTPS callback. The Client Secret
# stays in the server environment; never put a real value in this file.
# SCUT_SENIOR_IDENTITY_MODE=github_oauth
# SCUT_SENIOR_GITHUB_CLIENT_ID=
# SCUT_SENIOR_GITHUB_CLIENT_SECRET=
# SCUT_SENIOR_GITHUB_CALLBACK_URL=https://app.example/api/v1/auth/github/callback
# SCUT_SENIOR_POST_LOGIN_REDIRECT_URL=https://app.example/
SCUT_SENIOR_MODEL_MODE=mock
# Local opt-in requires github_oauth + sqlite as well as at least one rotated
# server-side platform key (OpenRouter and/or Zhipu bigmodel). Each provider's
# models must pass its health check before selection. Never commit or expose a key.
# SCUT_SENIOR_MODEL_MODE=openrouter_platform
SCUT_SENIOR_OPENROUTER_API_KEY=
# Zhipu bigmodel free key. Serves the fixed free models GLM-4.7-Flash
# (glm-4.7-flash), GLM-4-Flash-250414 (glm-4-flash-250414), and GLM-4.6V-Flash
# (glm-4.6v-flash). The server only ever reads this from the environment; never
# commit or expose the value.
SCUT_SENIOR_ZHIPU_API_KEY=
# BYOK is available only with real GitHub OAuth + sqlite and a server-only
# AES-256 master key. Generate 32 random bytes and base64-encode them; never
# reuse a provider API key here and never commit the value. OpenRouter,
# DeepSeek, SiliconFlow, and Zhipu become available when this key is valid.
SCUT_SENIOR_BYOK_MASTER_KEY=
SCUT_SENIOR_BYOK_KEY_VERSION=1
SCUT_SENIOR_STORAGE_MODE=sqlite_mock
# Use this only together with github_oauth. Auth sessions are server-side,
# fixed at 7 days, and the database stores token digests rather than raw tokens.
# SCUT_SENIOR_STORAGE_MODE=sqlite
SCUT_SENIOR_DATABASE_PATH=.local/iteration-zero.db
# The default remains the synthetic Fixture. local_corpus is only valid after
# a candidate source commit has reached trusted master and a separate guarded
# activation created the store; the store path must be absolute.
SCUT_SENIOR_RETRIEVAL_MODE=fixture
# SCUT_SENIOR_RETRIEVAL_MODE=local_corpus
# Dense retrieval is enabled by default; it activates when this local ONNX
# directory exists and contains model.onnx + tokenizer.json.
# SCUT_SENIOR_ONNX_MODEL_PATH=/absolute/path/to/bge-small-zh-v1.5
# SCUT_SENIOR_ONNX_MODEL_ID=bge-small-zh-v1.5
# SCUT_SENIOR_ONNX_EMBEDDING_DIMENSIONS=512
# SCUT_SENIOR_ONNX_MAX_LENGTH=512
# SCUT_SENIOR_CORPUS_STORE_PATH=/absolute/path/to/corpus-store
SCUT_SENIOR_CROSS_COURSE_ENABLED=false
SCUT_SENIOR_BILIBILI_RESOURCES_ENABLED=true
